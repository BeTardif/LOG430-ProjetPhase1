@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Client" as client

rectangle "CanBankX" {
    
    package "Identité & Accès" {
        usecase "UC-01: Inscription & KYC" as UC01
        usecase "UC-02: Authentification & MFA" as UC02
    }

    package "Gestion des Fonds" {
        usecase "UC-03: Ouverture de compte" as UC03
        usecase "UC-05: Virement sécurisé" as UC05
    }

    package "Sécurité" {
        usecase "UC-07: Détection AML" as UC07
    }

    client -- UC01
    client -- UC02
    client -- UC03
    client -- UC05

    UC01 ..> UC07 : <<include>>
    UC05 ..> UC07 : <<include>>
}
@enduml